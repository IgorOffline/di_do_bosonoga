var coin_flip is default_rand_binary
if coin_flip eq true
di
  asset_font_ttf ttf_font is dir_from_current "asset" file "IntelOneMono-Medium.ttf"
  asset_image_png alpha_image is dir_from_current "asset" file "alpha.png"
  asset_image_png bravo_image is dir_from_current "asset" file "bravo.png"
  asset_image_png charlie_image is dir_from_current "asset" file "charlie.png"

  theme "frappe" ttf_font 626880_hex alpha_image bravo_image charlie_image

  input_key_press_9
  di
    var test_count_raw is 0_i32
    var test_result is 0_i32
    var uri_gt is dir_from_current "test" file "gt.bosonoga"
    var test_gt is raw_import_and_execute uri_gt
    set test_result to_add test_result test_gt
    set test_count_raw to_add test_count_raw 1_i32
    var uri_lt is dir_from_current "test" file "lt.bosonoga"
    var test_lt is raw_import_and_execute uri_lt
    set test_result to_add test_result test_lt
    set test_count_raw to_add test_count_raw 1_i32
    var uri_if_else_gt_lt_nihil is dir_from_current "test" file "if_else_gt_lt_nihil.bosonoga"
    var test_if_else_gt_lt_nihil is raw_import_and_execute uri_if_else_gt_lt_nihil
    set test_result to_add test_result test_if_else_gt_lt_nihil
    set test_count_raw to_add test_count_raw 1_i32
    var uri_to_add is dir_from_current "test" file "to_add.bosonoga"
    var test_to_add is raw_import_and_execute uri_to_add
    set test_result to_add test_result test_to_add
    set test_count_raw to_add test_count_raw 1_i32
    var uri_to_add_multiple is dir_from_current "test" file "to_add_multiple.bosonoga"
    var test_to_add_multiple is raw_import_and_execute uri_to_add_multiple
    set test_result to_add test_result test_to_add_multiple
    set test_count_raw to_add test_count_raw 1_i32
    var uri_to_subtract is dir_from_current "test" file "to_subtract.bosonoga"
    var test_to_subtract is raw_import_and_execute uri_to_subtract
    set test_result to_add test_result test_to_subtract
    set test_count_raw to_add test_count_raw 1_i32
    var uri_to_subtract_multiple is dir_from_current "test" file "to_subtract_multiple.bosonoga"
    var test_to_subtract_multiple is raw_import_and_execute uri_to_subtract_multiple
    set test_result to_add test_result test_to_subtract_multiple
    set test_count_raw to_add test_count_raw 1_i32
    var uri_shift is dir_from_current "test" file "shift.bosonoga"
    var test_shift is raw_import_and_execute uri_shift
    set test_result to_add test_result test_shift
    set test_count_raw to_add test_count_raw 1_i32
    var test_count_passed is 0_i32
    set test_count_passed to_subtract test_count_raw test_result
    info "input_key_press_9 tests: " test_count_passed "/" test_count_raw
  do

  input_key_press_0
  di
    start
    info "[0]"
  do

  input_key_down_w
  di
    info "[W]"
  do

  input_key_down_s
  di
    info "[S]"
  do
do
else
di
  info "-coin_flip"
do
