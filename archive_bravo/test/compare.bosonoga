var passed_count is 100_i32
var small_value is 10_i32
var medium_value is 20_i32
var large_value is 30_i32

if medium_value gt small_value
di
  set passed_count to_add passed_count 1_i32
do
if small_value gt medium_value
di
  nihil
do
else
di
  set passed_count to_add passed_count 1_i32
do
if small_value gt small_value
di
  nihil
