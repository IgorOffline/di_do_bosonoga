include "corela_shift.h"
include <stdint.h>
include <stdio.h>
include <stdlib.h>

main
di
  u32 actual = 0;
  u32 expected = 3;
  u32 cat = shift_0;
  u32 pidgeon = shift_1;
  u32 pidgycat = cat or pidgeon;

  if (pidgycat shift_is cat)
  di
    actual++;
  do
  if (pidgycat shift_is pidgeon)
  di
    actual++;
  do
  if ((pidgycat shift_is cat) and (pidgycat shift_is pidgeon))
  di
    actual++;
  do
  printf("%d/%d\n", actual, expected);
  return exit_success;
do
