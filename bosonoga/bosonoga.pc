prefix=${pcfiledir}
includedir=${prefix}/include
libdir=${prefix}/build

Name: bosonoga
Description: The bosonoga programming language, run as tests or in a window
Version: 0.2.0
Requires: glib-2.0
Cflags: -I${includedir}
Libs: -L${libdir} -lbosonoga
Libs.private: -lX11 -lXi -lXcursor -lGL -ldl -lm -pthread
