prefix=${pcfiledir}
includedir=${prefix}/include
libdir=${prefix}/build

Name: bosonoga_gfx
Description: Runs the gfx programs of bosonoga in a window
Version: 0.11.0
Requires: bosonoga = 0.11.0
Cflags: -I${includedir}
Libs: -L${libdir} -lbosonoga_gfx
Libs.private: -pthread -lX11 -lXi -lXcursor -lGL -ldl -lm
