// aka.bosonoga

mod "aka_dice.bosonoga"_str

const zero is 0_i32

// Every i32, but not these three.
aka_i32 far except -1_i32 zero 1_i32

// Every i32 below 0.
aka_i32 low is from -2147483648_i32 to 0_i32

// The aka_i32 of a module is that of a parameter here too.
def double_fn roll_dice ret 0_i32
di
  var roll is to_i32 roll_dice
  set roll to_multiply 2_i32
  return roll
do

// A parameter is given as it is to a parameter of the same aka_i32, and is
// converted first for any other.
def both_fn roll_dice times_i32 ret 0_i32
di
  val doubled is double_fn of roll_dice with ret 0_i32
  var sum is score_fn of roll_dice with ret 0_i32
  set sum to_add doubled
  set sum to_multiply times_i32
  return sum
do

def inverse_fn value_far ret 0_i32
di
  val value is to_i32 value_far
  var inverse is 100_i32
  set inverse to_divide value
  return inverse
do

def is_low_fn value_low ret 0_bool
di
  var value is 0_i32
  set value to_i32 value_low
  if value lt 0_i32
  di
    return true_bool
  do
  return false_bool
do

// Its own call is given its own parameter.
def countdown_fn roll_dice times_i32 ret_void
di
  info "countdown "_str times_i32
  if times_i32 gt 0_i32
  di
    var less is times_i32
    set less to_subtract 1_i32
    call countdown_fn of roll_dice less
  do
do

bosonoga_main
di
  // Known before the program runs: a literal, a constant and a val.
  val five is 5_i32
  val double is double_fn of five with ret 0_i32
  val score is score_fn of zero with ret 0_i32
  val both is both_fn of 2_i32 3_i32 with ret 0_i32
  // Not known, so checked by the call.
  var face is 17_i32
  set face to_mod 6_i32
  val rolled is score_fn of face with ret 0_i32
  val inverse is inverse_fn of -2_i32 with ret 0_i32
  val ends is inverse_fn of 2147483647_i32 with ret 0_i32
  val is_low is is_low_fn of -2147483648_i32 with ret 0_bool
  call countdown_fn of 1_i32 1_i32
  if double eq 10_i32 and score eq 0_i32 and both eq 72_i32 and rolled eq 50_i32
    and inverse eq -50_i32 and ends eq 0_i32 and is_low
  di
    return exit_success
  do
  return exit_failure
do
