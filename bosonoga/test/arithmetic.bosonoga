// arithmetic.bosonoga

bosonoga_main
di
  var count is 1_f32 // 1
  set count tu_add 2_f32 3_f32 // 6
  set count math_tu_pow count 3_f32 // 216
  set count tu_subtract 6_f32 10_f32 // 200
  set count tu_divide 10_f32 // 20
  set count tu_add 5_f32 // 25
  set count math_tu_sqrt count // 5
  // Each operation starts from its variable, as += does in C.
  var left is 17_i32
  set left tu_mod 5_i32 // 2
  set left tu_multiply 3_i32 4_i32 // 24
  set left tu_subtract 30_i32 // -6
  set left tu_divide -2_i32 // 3

  // eq_3 and eq_6 hold if the difference is at most 0.001 or 0.000001,
  // however large the values are.
  if 1000000d0_f64 eq_3 1000900d0_f64 or not 1d0_f64 eq_3 1d0009_f64
    or 1d0_f64 eq_6 1d00001_f64
  di
    return exit_failure
  do
  if count eq_3 5_f32 and left eq 3_i32
  di
    return exit_success
  do
  return exit_failure
do
