// array.bosonoga

val column_letters is array 0_str
di
  row "A"_str
  row "B"_str
  row "C"_str
do

bosonoga_main
di
  var column is 0_i32
  set column to_add 2_i32
  val letter is column_letters at column with ret 0_str
  if letter eq "C"_str
  di
    return exit_success
  do
  return exit_failure
do
