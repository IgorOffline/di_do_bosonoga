// call.bosonoga

val pairs is array name_str count_i32
di
  row "seven"_str 7_i32
  row "nine"_str 9_i32
do

def divide_fn dividend_i32 divisor_i32 ret quotient_i32 remainder_i32
di
  var quotient is dividend_i32
  set quotient to_divide divisor_i32
  var remainder is dividend_i32
  set remainder to_mod divisor_i32
  return quotient remainder
do

// A number and whether it was parsed, two values that call takes.
def parsed_fn text_str ret parsed_bool number_i32
di
  str_parse text_str with ret parsed_bool number_i32
  di
    if parsed_bool
    di
      return true_bool number_i32
    do
  do
  return false_bool 0_i32
do

// A return inside the block of a call leaves the function.
def sum_fn first_str second_str ret summed_bool sum_i32
di
  call parsed_fn of first_str with ret parsed_bool as has_first number_i32 as first
  di
    if not has_first
    di
      return false_bool 0_i32
    do
    call parsed_fn of second_str with ret parsed_bool as has_second number_i32 as second
    di
      if has_second
      di
        var sum is first
        set sum to_add second
        return true_bool sum
      do
    do
  do
  return false_bool 0_i32
do

def countdown_fn from_i32 ret_void
di
  info "countdown "_str from_i32
  if from_i32 gt 0_i32
  di
    var next is from_i32
    set next to_subtract 1_i32
    call countdown_fn of next
  do
do

def hello_fn ret_void
di
  info "hello"_str
do

main
di
  call hello_fn
  call countdown_fn of 2_i32
  var grid is array value_i32 marked_bool with_len_col 3_i32
  set grid at 2_i32 to 5_i32 true_bool
  // One column of a row is set by its name, and an operation starts from it.
  set grid at 1_i32 value_i32 to 4_i32
  set grid at 1_i32 value_i32 to_add 3_i32
  var ok is true_bool
  // A value of a def is taken as a val of its own name, or of the name
  // after as.
  call divide_fn of 17_i32 5_i32 with ret quotient_i32 remainder_i32
  di
    if quotient_i32 not_eq 3_i32 or remainder_i32 not_eq 2_i32
    di
      set ok to false_bool
    do
  do
  // Only the values that a block needs are taken.
  call divide_fn of 9_i32 2_i32 with ret remainder_i32 as odd
  di
    if odd not_eq 1_i32
    di
      set ok to false_bool
    do
  do
  // val takes one value of a def that returns more.
  val quotient is divide_fn of 17_i32 5_i32 with ret quotient_i32
  if quotient not_eq 3_i32
  di
    set ok to false_bool
  do
  // The values are taken in any order.
  call sum_fn of "40"_str "2"_str with ret sum_i32 summed_bool
  di
    if not summed_bool or sum_i32 not_eq 42_i32
    di
      set ok to false_bool
    do
  do
  call sum_fn of "40"_str "two"_str with ret summed_bool as missing
  di
    if missing
    di
      set ok to false_bool
    do
  do
  // A column is taken as a val of its own name, or of the name after as.
  call pairs at 1_i32 with ret name_str as name count_i32
  di
    if name not_eq "nine"_str or count_i32 not_eq 9_i32
    di
      set ok to false_bool
    do
  do
  // The columns are taken in any order.
  call grid at 2_i32 with ret marked_bool value_i32
  di
    if value_i32 not_eq 5_i32 or not marked_bool
    di
      set ok to false_bool
    do
  do
  // val takes one column of a row of more.
  val seven is grid at 1_i32 with ret value_i32
  val unmarked is grid at 1_i32 with ret marked_bool
  if seven not_eq 7_i32 or unmarked
  di
    set ok to false_bool
  do
  val nine is pairs at 1_i32 with ret count_i32 then to_add 0_i32
  if nine not_eq 9_i32
  di
    set ok to false_bool
  do
  if ok
  di
    return exit_success
  do
  return exit_failure
do
