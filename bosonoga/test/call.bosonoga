// call.bosonoga

val pairs is array 0_str 1_i32
di
  row "seven"_str 7_i32
  row "nine"_str 9_i32
do

def divide_fn dividend_i32 divisor_i32 ret 0_i32 1_i32
di
  var quotient is dividend_i32
  set quotient to_divide dividend_i32 divisor_i32
  var remainder is dividend_i32
  set remainder to_mod dividend_i32 divisor_i32
  return quotient remainder
do

// A number that may be missing, as Rust's Option<i32>.
def parsed_fn text_str ret 0_bool 1_i32
di
  str_parse text_str with ret 0_bool as parsed 1_i32 as number
  di
    if parsed
    di
      return true_bool number
    do
  do
  return false_bool 0_i32
do

// A return inside the block of a call leaves the function.
def sum_fn first_str second_str ret 0_bool 1_i32
di
  call parsed_fn of first_str with ret 0_bool as has_first 1_i32 as first
  di
    if not has_first
    di
      return false_bool 0_i32
    do
    call parsed_fn of second_str with ret 0_bool as has_second 1_i32 as second
    di
      if has_second
      di
        var sum is first
        set sum to_add sum second
        return true_bool sum
      do
    do
  do
  return false_bool 0_i32
do

def countdown_fn from_i32 ret_void
di
  info "countdown "_str from_i32
  if from_i32 gt 0_i32
  di
    var next is from_i32
    set next to_subtract next 1_i32
    call countdown_fn of next
  do
do

def hello_fn ret_void
di
  info "hello"_str
do

bosonoga_main
di
  call hello_fn
  call countdown_fn of 2_i32
  var grid is array 0_i32 1_bool with_len_col 3_i32
  set grid at 2_i32 to 5_i32 true_bool
  var ok is true_bool
  call divide_fn of 17_i32 5_i32 with ret 0_i32 as quotient 1_i32 as remainder
  di
    if quotient not_eq 3_i32 or remainder not_eq 2_i32
    di
      set ok to false_bool
    do
  do
  // Only the values that a block needs are taken.
  call divide_fn of 9_i32 2_i32 with ret 1_i32 as odd
  di
    if odd not_eq 1_i32
    di
      set ok to false_bool
    do
  do
  call sum_fn of "40"_str "2"_str with ret 0_bool as summed 1_i32 as sum
  di
    if not summed or sum not_eq 42_i32
    di
      set ok to false_bool
    do
  do
  call sum_fn of "40"_str "two"_str with ret 0_bool as missing
  di
    if missing
    di
      set ok to false_bool
    do
  do
  call pairs at 1_i32 with ret 0_str as name 1_i32 as count
  di
    if name not_eq "nine"_str or count not_eq 9_i32
    di
      set ok to false_bool
    do
  do
  call grid at 2_i32 with ret 0_i32 as value 1_bool as marked
  di
    if value not_eq 5_i32 or not marked
    di
      set ok to false_bool
    do
  do
  if ok
  di
    return exit_success
  do
  return exit_failure
do
