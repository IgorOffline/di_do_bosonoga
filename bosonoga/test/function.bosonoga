// function.bosonoga

const board_radius is 4_i32

def in_bounds_fn q_i32 r_i32 ret 0_bool
di
  var s is 0_i32
  set s to_subtract s q_i32 r_i32
  var steps is math_to_abs q_i32
  var r_steps is math_to_abs r_i32
  var s_steps is math_to_abs s
  set steps math_to_max steps r_steps
  set steps math_to_max steps s_steps
  if steps le board_radius
  di
    return true_bool
  do
  return false_bool
do

def factorial_fn n_i64 ret 0_i64
di
  if n_i64 le 1_i64
  di
    return 1_i64
  do
  var smaller is n_i64
  set smaller to_subtract smaller 1_i64
  val rest is factorial_fn of smaller with ret 0_i64
  var product is n_i64
  set product to_multiply product rest
  return product
do

bosonoga_main
di
  val inside is in_bounds_fn of 2_i32 -3_i32 with ret 0_bool
  val outside is in_bounds_fn of 3_i32 2_i32 with ret 0_bool
  val twenty is factorial_fn of 20_i64 with ret 0_i64
  if inside and not outside and twenty eq 2432902008176640000_i64
  di
    return exit_success
  do
  return exit_failure
do
