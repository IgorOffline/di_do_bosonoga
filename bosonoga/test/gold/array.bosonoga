// array.bosonoga

val steps is array 0_i32 1_str
di
  row 1_i32 "one"_str
  row 2_i32 "two"_str
  row 3_i32 "three"_str
do

const step_count is len_col steps

def sum_fn ret 0_i32
di
  var nodes is array 0_i32 rows 4_i32
  var total is 0_i32
  to_4 with index
  di
    set nodes at index to index
  do
  to_4 with index
  di
    val node is nodes at index with ret 0_i32
    set total to_add total node
  do
  return total
do

bosonoga_global
di
  var board is array 0_i32 1_bool 2_str rows 3_i32
do

bosonoga_main
di
  var width is len_row steps
  info "steps: "_str step_count " rows of "_str width
  call steps at 2_i32 with ret
    0_i32 as number
    1_str as name
  di
    info number " "_str name
  do
  call board at 1_i32 with ret
    0_i32 as kind
    1_bool as taken
    2_str as label
  di
    info "zeroed: "_str kind " "_str taken " ["_str label "]"_str
  do
  set board at 1_i32 to 2_i32 true_bool "arrow"_str
  call board at 1_i32 with ret
    0_i32 as kind
    1_bool as taken
    2_str as label
  di
    info "written: "_str kind " "_str taken " "_str label
  do
  var path is array 0_i32 1_i32
  di
    row 0_i32 -4_i32
    row 0_i32 4_i32
  do
  set width to len_col path
  info "path: "_str width
  var last is len_col path
  set last to_subtract last 1_i32
  call path at last with ret
    1_i32 as r
  di
    info "gate: "_str r
  do
  val sum is sum_fn with ret 0_i32
  info "sum: "_str sum
  to_2
  di
    var fresh is array 0_i32 rows 1_i32
    val before is fresh at 0_i32 with ret 0_i32
    info "fresh: "_str before
    set fresh at 0_i32 to 9_i32
  do
  return exit_success
do
