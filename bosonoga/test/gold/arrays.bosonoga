// arrays.bosonoga

// An array of one type, read like a function that returns one value.
array places 0_i32
di
  row 1_i32
  row 10_i32
  row 100_i32
  row 1000_i32
do

// An array of several types, whose rows are read with call ... with ret.
array task 0_i32 1_i32 2_str
di
  row 347_i32 285_i32 "first"_str
  // A comment can be between rows.
  row 458_i32 376_i32 "second"_str
  row 125_i32 -263_i32 "third"_str
do

// Every type, and a color of the settings, which is a literal.
array mixed 0_f32 1_flags 2_color 3_str 4_i32
di
  row 1d5_f32 shift_3 color_rectangle "a"_str 7_i32
do

// A function reads an array that is defined before it.
fn digit_at number_i32 column_i32 ret 0_i32
di
  var place is places column_i32 ret 0_i32
  var digit is 0_i32
  set digit to_divide number_i32 place
  set digit to_mod digit 10_i32
  return digit
do

// A function returns a row that it reads.
fn task_of index_i32 ret 0_i32 1_i32 2_str
di
  call task index_i32 with ret
  di
    return ret_0_i32 ret_1_i32 ret_2_str
  do
do

bosonoga_main
di
  var digits is 0_i32
  to_4 with column
  di
    var digit is digit_at 4071_i32 column ret 0_i32
    info "digit "_str column " is "_str digit
    set digits to_add digits digit
  do

  var sum is 0_i32
  to_3 with index
  di
    var first is 0_i32
    var second is 0_i32
    var name is ""_str
    call task index with ret
    di
      set first to_add ret_0_i32
      set second to_add ret_1_i32
      set name to_add ret_2_str
    do
    var added is 0_i32
    set added to_add first second
    info name " "_str added
    set sum to_add sum added
  do

  // The row is copied out, so a read in the block of another keeps ret_0_i32.
  var copied is 0_i32
  call task_of 1_i32 with ret
  di
    var place is places 2_i32 ret 0_i32
    set copied to_add ret_0_i32 place
  do
  info "copied "_str copied

  call mixed 0_i32 with ret
  di
    info ret_0_f32 " "_str ret_1_flags " "_str ret_2_color " "_str ret_3_str " "_str ret_4_i32
  do

  var last is 0_i32
  set last to places 3_i32 ret 0_i32
  info "last "_str last

  if digits eq 12_i32 and sum eq 1328_i32 and copied eq 558_i32
  and last eq 1000_i32
  di
    return exit_success
  do
  return exit_failure
do
