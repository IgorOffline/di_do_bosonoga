// Constants are immutable, visible to functions, and usable in literal tables.
const pi is 3d141592653589793_f64
const circle_pi is pi
const label is "f64 and constants: passed"_str
const unit is 1_f64

array values 0_f64 1_f32 2_i32
di
  row circle_pi 1d25_f32 7_i32
do

def diameter_fn radius_f64 ret 0_f64
di
  var result is radius_f64
  set result to_multiply result 2_f64
  return result
do

def circle_fn radius_f64 ret 0_f64 1_f64
di
  var circumference is diameter_fn of radius_f64 with ret 0_f64
  set circumference to_multiply circumference circle_pi
  var area is radius_f64
  set area to_multiply area radius_f64 circle_pi
  return circumference area
do

bosonoga_main
di
  var precise is 16777217_f64
  var difference is precise
  set difference to_subtract difference 16777216_f64
  if not difference eq_6 unit
  di
    return exit_failure
  do
  var tiny is 1d000000000001_f64
  set tiny to_subtract tiny unit
  if tiny le 0d0000000000005_f64 or tiny ge 0d000000000002_f64
  di
    return exit_failure
  do
  var count is 17_i32
  var wide is to_f64 count
  var narrow is to_f32 wide
  set wide to_f64 narrow
  set count to_i32 wide
  if count not_eq 17_i32
  di
    return exit_failure
  do
  var value is 0_f64
  call values at 0_i32 with ret
  di
    set value to_add ret_0_f64
  do
  if not value eq_6 pi
  di
    return exit_failure
  do
  var circumference is 0_f64
  var area is 0_f64
  call circle_fn of 2_f64 with ret
  di
    set circumference to_add ret_0_f64
    set area to_add ret_1_f64
  do
  if not circumference eq_6 12d566370614359172_f64
  or not area eq_6 12d566370614359172_f64
  di
    return exit_failure
  do
  var reciprocal is 0_f64
  set reciprocal to_divide 4_f64
  var remainder is 0_f64
  set remainder to_mod 7d5_f64 2_f64
  if not reciprocal eq_6 0d25_f64 or not remainder eq_6 1d5_f64
  di
    return exit_failure
  do
  info precise
  info label
  return exit_success
do
