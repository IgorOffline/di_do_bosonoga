// gfx_rectangle.bosonoga

gfx_init
di
  var chosen_color is color_rectangle
  info chosen_color " "_str color_background
do

gfx_frame
di
  gfx_clear color_background
  var rectangle_width is 32d0_f32
  to_2
  di
    draw_rectangle 120d0_f32 240d0_f32 rectangle_width 18d0_f32 color_rectangle
  do
do

gfx_main
di
  return exit_success
do
