// io.bosonoga

bosonoga_main
di
  info dir_fixture " "_str dir_scratch
  io_read dir_fixture "shelf.xml"_str with ret 0_bool as read 1_xml_str as shelf
  di
    info read
    xml_child shelf "book"_str 1_i32 with ret 0_bool as found 1_xml_str as book
    di
      xml_attribute book "title"_str with ret 1_str as title
      di
        info found " "_str title
      do
    do
  do
  io_read dir_fixture "missing.xml"_str with ret 0_bool as read 2_str as reason
  di
    info read " "_str reason
  do

  io_write dir_scratch "note.txt"_str "hello"_str with ret 0_bool as saved 1_bool as taken
  di
    info saved " "_str taken
  do
  io_write dir_scratch "note.txt"_str "again"_str with ret 0_bool as saved 1_bool as taken 2_str as reason
  di
    info saved " "_str taken " "_str reason
  do
  io_read dir_scratch "note.txt"_str with ret 1_str as text
  di
    info text
  do
  io_read dir_scratch "note.txt"_str with ret 0_bool as read
  di
    info read
  do
  io_read dir_scratch "note.txt"_str with ret 0_bool as read 1_xml_str as document 2_str as reason
  di
    info read " "_str reason document
  do

  var list is new xml_str element "list"_str "count"_str 2_i32
  io_write dir_scratch "list.xml"_str list with ret 0_bool as saved
  di
    info saved
  do
  unset list
  io_read dir_scratch "list.xml"_str with ret 1_xml_str as document
  di
    info document
  do
  io_read dir_scratch "list.xml"_str with ret 1_str as text
  di
    info text
  do

  io_modified dir_scratch "note.txt"_str with ret 0_bool as found 1_i64 as modified
  di
    if found and modified gt 0_i64
    di
      info "modified"_str
    do
  do
  io_modified dir_scratch "missing.txt"_str with ret 0_bool as found 1_i64 as modified
  di
    info found " "_str modified
  do
  return exit_success
do
