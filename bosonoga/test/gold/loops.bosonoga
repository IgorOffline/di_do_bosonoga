// loops.bosonoga

bosonoga_main
di
  var passed_count is 0_i32

  // while checks its condition before each run, so it can run no times.
  var count is 0_i32
  while count lt 5_i32
  di
    set count to_add count 1_i32
  do
  var never is 0_i32
  while count lt 0_i32
  di
    set never to_add never 1_i32
  do
  if count eq 5_i32 and never eq 0_i32
  di
    set passed_count to_add passed_count 1_i32
  do

  // continue skips the rest of a run of a LOOP, and break leaves it.
  var odd_sum is 0_i32
  var last is 0_i32
  to_100 with number
  di
    if number gt 9_i32
    di
      break
    do
    set last to_add number
    var remainder is 0_i32
    set remainder to_mod number 2_i32
    if remainder eq 0_i32
    di
      continue
    do
    set odd_sum to_add odd_sum number
  do
  // 1 + 3 + 5 + 7 + 9 = 25, and 10 broke out before last was set.
  if odd_sum eq 25_i32 and last eq 9_i32
  di
    set passed_count to_add passed_count 1_i32
  do

  // continue in a while checks the condition again, and break leaves it.
  var step is 0_i32
  var skipped is 0_i32
  while step lt 100_i32
  di
    set step to_add step 1_i32
    if step le 3_i32
    di
      set skipped to_add skipped 1_i32
      continue
    do
    if step eq 7_i32
    di
      break
    do
  do
  if step eq 7_i32 and skipped eq 3_i32
  di
    set passed_count to_add passed_count 1_i32
  do

  // break only leaves the innermost loop.
  var inner_runs is 0_i32
  var outer_runs is 0_i32
  to_3
  di
    set outer_runs to_add outer_runs 1_i32
    var inner is 0_i32
    while not inner eq 10_i32
    di
      set inner to_add inner 1_i32
      if inner eq 2_i32
      di
        break
      do
      set inner_runs to_add inner_runs 1_i32
    do
  do
  if outer_runs eq 3_i32 and inner_runs eq 3_i32
  di
    set passed_count to_add passed_count 1_i32
  do

  if passed_count eq 4_i32
  di
    return exit_success
  do
  return exit_failure
do
