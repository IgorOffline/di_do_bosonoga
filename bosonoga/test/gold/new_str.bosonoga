// new_str.bosonoga

def column_letter_fn index_i32 ret 0_str
di
  if index_i32 eq 0_i32
  di
    return "A"_str
  do
  return "B"_str
do

// A function makes and unsets its own, before it returns.
def is_label_fn column_str row_i32 expected_str ret 0_bool
di
  val label is new str of column_str row_i32
  var same is false_bool
  if label eq expected_str
  di
    set same to true_bool
  do
  unset label
  return same
do

bosonoga_main
di
  val action is 3_i32
  val counter is new str of "Action "_str action " / "_str 24_i32
  info counter
  unset counter

  // The name is free again after its unset.
  var counter is new str of "half "_str 0d5_f64 " "_str true_bool " "_str 7_u64
  info counter
  if counter not_eq "half"_str
  di
    info "not only half"_str
  do
  unset counter

  // One new and unset in each iteration.
  to_2 with column
  di
    val letter is column_letter_fn of column with ret 0_str
    to_2 with down
    di
      var number is down
      set number to_add number 1_i32
      val label is new str of letter number
      val copy is new str of label
      if label eq copy
      di
        info label
      do
      unset copy
      unset label
    do
  do

  val b2 is is_label_fn of "B"_str 2_i32 "B2"_str with ret 0_bool
  val a3 is is_label_fn of "A"_str 3_i32 "A2"_str with ret 0_bool
  info b2 " "_str a3
  return exit_success
do
