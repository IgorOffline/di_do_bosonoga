// val_and_bool.bosonoga

const verbose is true_bool

array task 0_i32 1_bool
di
  row 4_i32 true_bool
  row 7_i32 false_bool
  row 10_i32 true_bool
do

def is_even_fn number_i32 ret 0_bool
di
  val rest is 0_i32
  var remainder is 0_i32
  set remainder to_mod number_i32 2_i32
  if remainder eq rest
  di
    return true_bool
  do
  return false_bool
do

def flip_fn value_bool ret 0_bool
di
  if value_bool
  di
    return false_bool
  do
  return true_bool
do

bosonoga_main
di
  var right is 0_i32
  to_3 with index
  di
    call task at index with ret
      0_i32 as number
      1_bool as expected
    di
      val actual is is_even_fn of number with ret 0_bool
      info number " "_str actual
      if actual eq expected
      di
        set right to_add right 1_i32
      do
    do
  do

  val limit is 3_f64
  val half is to_f64 right
  info "limit "_str limit " half "_str half " verbose "_str verbose

  var done is false_bool
  var steps is 0_i32
  while not done
  di
    set steps to_add steps 1_i32
    if steps ge 4_i32
    di
      set done to true_bool
    do
  do
  info "steps "_str steps " done "_str done

  set done to flip_fn of done with ret 0_bool
  var label is "car"_str
  set label to "walk"_str
  var copy is 0_i32
  set copy to steps
  info label " "_str done " "_str copy

  if done or verbose and copy eq 4_i32
  di
    set right to_add right 1_i32
  do
  if not done and done not_eq verbose
  di
    set right to_add right 1_i32
  do

  if right eq 5_i32
  di
    return exit_success
  do
  return exit_failure
do
