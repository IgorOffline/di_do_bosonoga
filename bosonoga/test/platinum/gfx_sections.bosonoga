// gfx_sections.bosonoga

bosonoga_global
di
  var count is 1_i32
do

gfx_init
di
  var local_count is 2_i32
  set local_count to_add local_count count
  info "init "_str local_count
do

gfx_frame
di
  info "a test has no frames"_str
do

gfx_cleanup
di
  var local_count is 500_i32
  set local_count to_add local_count count
  info "cleanup "_str local_count
do

gfx_main
di
  var local_count is 40_i32
  set local_count to_add local_count count
  sleep_ms 1_u32
  info "main "_str local_count
  return exit_success
do
