// global.bosonoga
//
// bosonoga_global without gfx: its variables are visible in bosonoga_main,
// which shares them, and its info runs first.

// A function before bosonoga_global, which only sees its own variables.
fn doubled value_i32 ret i32
di
  var result is 0_i32
  set result to_add value_i32 value_i32
  return result
do

bosonoga_global
di
  var count is doubled 3_i32
  var name is "global"_str
  info name " "_str count
  if count eq 6_i32
  di
    // A variable of an inner block belongs to that block.
    var inner is 1_i32
    set count to_add count inner
  do
do

array step i32
di
  row 10_i32
do

bosonoga_main
di
  // The variable inner was not at the top of bosonoga_global, so this is a
  // new one.
  var inner is step 0_i32
  set count to_add count inner
  info "main "_str count
  if count eq 17_i32 and name eq "global"_str
  di
    return exit_success
  do
  return exit_failure
do
