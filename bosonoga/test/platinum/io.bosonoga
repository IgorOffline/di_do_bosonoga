// io.bosonoga

bosonoga_main
di
  // Reads a replay as corela writes it.
  var last is 0_i32
  var count is 0_i32
  io_read dir_fixture "io_replay.xml"_str with ret
    0_bool as read
    1_xml_str as replay
  di
    if read
    di
      info "read io_replay.xml"_str
    do
    xml_attribute replay "last_action"_str with ret
      0_bool as found
      1_str as text
    di
      str_parse text with ret
        0_bool as parsed
        1_i32 as number
      di
        if found and parsed
        di
          set last to number
        do
      do
    do
    var index is 0_i32
    var more is true_bool
    while more
    di
      xml_child replay "action"_str index with ret
        0_bool as found
        1_xml_str as action
      di
        set more to found
        if found
        di
          xml_attribute action "note"_str with ret
            1_str as note
          di
            info "action "_str index ": "_str note
          do
          xml_child action "command"_str 0_i32 with ret
            1_xml_str as command
          di
            xml_attribute command "type"_str with ret
              1_str as type
            di
              info "  command "_str type
            do
          do
          set count to_add count 1_i32
        do
      do
      set index to_add index 1_i32
    do
  do
  info "last_action "_str last ", actions "_str count

  // A text is read as a str, which an xml_str it is not.
  io_read dir_fixture "io_text.txt"_str with ret
    0_bool as read
    1_str as text
  di
    if read
    di
      info "text: "_str text
    do
  do
  io_read dir_fixture "io_text.txt"_str with ret
    0_bool as read
    2_str as reason
  di
    // Only a text that the block takes is checked, so this one is read.
    if read and reason eq ""_str
    di
      info "read without taking the text"_str
    do
  do
  io_read dir_fixture "io_text.txt"_str with ret
    0_bool as read
    1_xml_str as text
    2_str as reason
  di
    if not read and text eq ""_str and reason not_eq ""_str
    di
      info "io_text.txt is not an xml document"_str
    do
  do
  io_read dir_fixture "io_missing.xml"_str with ret
    0_bool as read
    2_str as reason
  di
    if not read and reason not_eq ""_str
    di
      info "io_missing.xml is not read"_str
    do
  do
  io_modified dir_fixture "io_missing.xml"_str with ret
    0_bool as found
  di
    if not found
    di
      info "io_missing.xml has no time"_str
    do
  do

  // Writes a replay under the first free number, and reads it back.
  var node is new xml_str element "node"_str "region"_str "center"_str "q"_str 0_i32 "r"_str -1_i32 "type"_str "start"_str
  var action is new xml_str element "action"_str "number"_str 1_i32 "note"_str "a & b <c>"_str of node
  unset node
  var written is new xml_str element "replay"_str "name"_str "corela_bpmn"_str "last_action"_str 1_i32 of action
  unset action
  info written
  var number is 1000_i32
  var is_written is false_bool
  while not is_written and number le 9999_i32
  di
    var name is new str of "replay_"_str number ".xml"_str
    io_write dir_scratch name written with ret
      0_bool as saved
      1_bool as taken
    di
      if saved
      di
        set is_written to true_bool
      do
      else if taken
      di
        set number to_add number 1_i32
      do
      else
      di
        set number to 10000_i32
      do
    do
    unset name
  do
  if is_written
  di
    info "written"_str
  do
  var name is new str of "replay_"_str number ".xml"_str
  io_read dir_scratch name with ret
    0_bool as read
    1_xml_str as back
  di
    if read and back eq written
    di
      info "read back the same"_str
    do
  do
  io_modified dir_scratch name with ret
    0_bool as found
    1_i64 as modified
  di
    if found and modified gt 0_i64
    di
      info "it has a time"_str
    do
  do
  io_write dir_scratch name written with ret
    1_bool as taken
  di
    if taken
    di
      info "a file is written once"_str
    do
  do
  unset name
  unset written

  io_write dir_scratch "plain.txt"_str "plain text"_str with ret
    0_bool as saved
    1_bool as taken
  di
    if saved or taken
    di
      info "plain.txt is there"_str
    do
  do
  io_read dir_scratch "plain.txt"_str with ret
    1_str as text
  di
    if text eq "plain text"_str
    di
      info "plain.txt says plain text"_str
    do
  do
  return exit_success
do
