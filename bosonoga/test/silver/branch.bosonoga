// branch.bosonoga

bosonoga_main
di
  var passed is 0_i32
  val small is 10_i32
  val medium is 20_i32

  if small gt medium
  di
    nihil
  do
  else if medium gt small
  di
    set passed to_add passed 1_i32
  do
  else
  di
    nihil
  do

  if small gt medium
  di
    nihil
  do
  else if small eq medium
  di
    nihil
  do
  else
  di
    set passed to_add passed 1_i32
  do

  if small lt medium
  di
    set passed to_add passed 1_i32
  do
  else
  di
    nihil
  do

  if passed eq 3_i32
  di
    return exit_success
  do
  return exit_failure
do
