// integer_types.bosonoga

const kilo is 1000_i64

def widen_fn count_u32 total_u64 ret 0_u64 1_i64
di
  var wide is to_u64 count_u32
  set wide to_add wide total_u64
  var negative is to_i64 wide
  set negative to_subtract negative
  return wide negative
do

array sizes 0_u32 1_i64 di
  row 4000000000_u32 -9000000000_i64
  row 7_u32 9000000000_i64
do

bosonoga_main
di
  var seconds is 4000000000_u32
  var distance is 9000000000_i64
  var bits is 18446744073709551615_u64
  info seconds " "_str distance " "_str bits

  set distance to_multiply distance kilo
  set distance to_divide distance 7_i64
  var rest is distance
  set rest to_mod distance kilo
  info distance " "_str rest

  var count is 10_u32
  set count to_subtract count 3_u32 2_u32
  set count to_multiply count count
  info count

  call widen_fn of 7_u32 10_u64 with ret
  di
    info ret_0_u64 " "_str ret_1_i64
  do
  call sizes at 0_i32 with ret
  di
    info ret_0_u32 " "_str ret_1_i64
  do

  var half is to_u32 2d75_f32
  var rounded is to_f64 bits
  info half " "_str rounded
  var magnitude is to_abs -42_i64
  var smaller is to_min seconds 3000000000_u32
  var unsigned is to_abs bits
  var zero is -0_u32
  info magnitude " "_str smaller " "_str unsigned " "_str zero

  if seconds gt 3999999999_u32 and bits eq 18446744073709551615_u64
  and distance not_eq 0_i64
  di
    info "compared"_str
  do

  var pause is 1_u32
  sleep_ms pause
  sleep_ms zero
  return exit_success
do
