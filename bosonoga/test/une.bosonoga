// une.bosonoga

// A name that starts with une_ can be unused.
const une_limit is 10_i32

aka_i32 une_fov is from 1_i32 to 180_i32

// It can also be used.
aka_i32 une_dice is from 0_i32 to 6_i32

val une_pairs is array 0_i32
di
  row 1_i32
do

bosonoga_global
di
  var total is 1_i32
  var une_count is 0_i32
do

def une_hello_fn with from_global une_count ret_void
di
  nihil
do

def both_fn left_i32 une_i32 une_roll_une_dice ret 0_i32 1_i32
di
  return left_i32 left_i32
do

def rolled_fn roll_une_dice with from_global total ret 0_i32
di
  val roll is to_i32 roll_une_dice
  var sum is total
  set sum to_add roll
  return sum
do

bosonoga_main
di
  val une_seven is 7_i32
  var une_set is 0_i32
  set une_set to 1_i32
  val une_read is 2_i32
  call both_fn of une_read 3_i32 4_i32 with ret 0_i32 as une_left
  di
    nihil
  do
  val three is rolled_fn of une_read with ret 0_i32
  if three eq 3_i32
  di
    return exit_success
  do
  return exit_failure
do
