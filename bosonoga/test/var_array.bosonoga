// var_array.bosonoga

bosonoga_main
di
  var counts is array 0_i32 with_len_col 4_i32
  set counts at 2_i32 to 7_i32
  var total is 0_i32
  var index is 0_i32
  while index lt 4_i32
  di
    val count is counts at index with ret 0_i32
    set total to_add total count
    set index to_add index 1_i32
  do
  var pairs is array 0_i32
  di
    row 3_i32
    row 5_i32
  do
  var last is 0_i32
  set last to pairs at 1_i32 with ret 0_i32
  set total to_add total last
  if total eq 12_i32
  di
    return exit_success
  do
  return exit_failure
do
