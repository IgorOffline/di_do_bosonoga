// var_array.bosonoga

bosonoga_main
di
  var counts is array 0_i32 vit_len_kol 4_i32
  set counts at 2_i32 tu 7_i32
  var total is 0_i32
  var index is 0_i32
  while index lt 4_i32
  di
    val count is counts at index vit ret 0_i32
    set total tu_add count
    set index tu_add 1_i32
  do
  var pairs is array 0_i32
  di
    roa 3_i32
    roa 5_i32
  do
  var last is 0_i32
  set last tu pairs at 1_i32 vit ret 0_i32
  set total tu_add last
  if total eq 12_i32
  di
    return exit_success
  do
  return exit_failure
do
