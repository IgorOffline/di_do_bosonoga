// lega.bosonoga
//
// lega word    a whole word, as di
// lega _word   a suffix, as _i32 of 7_i32
// lega word_   a prefix, as shift_ of shift_0

// suffixes of types
lega _i32
lega _i64
lega _u32
lega _u64
lega _f32
lega _f64
lega _flags
