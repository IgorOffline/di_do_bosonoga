// main.bosonoga

bosonoga_global
di
  // How far right of the original position the rectangle is, and which way it
  // is moving: 1 is right and -1 is left.
  var offset is 0d0_f32
  var direction is 1d0_f32
  // The angle of the orbiter around the centre of the window, in radians.
  var angle is 0d0_f32
do

gfx_frame
di
  var step is 0d0_f32
  set step to_multiply global_speed gfx_delta_time direction
  set offset to_add offset step
  if offset gt 100d0_f32
  di
    set offset to_add 100d0_f32
    set direction to_add -1d0_f32
  do
  if offset lt 0d0_f32
  di
    set offset to_add 0d0_f32
    set direction to_add 1d0_f32
  do
  var x is 120d0_f32
  set x to_add x offset

  // The orbiter circles the centre of the window at a radius of 120 px, with
  // to_cos and to_sin. One turn is 2 pi radians.
  var angle_step is 0d0_f32
  set angle_step to_multiply global_orbit_speed gfx_delta_time
  set angle to_add angle angle_step
  if angle gt 6d283185_f32
  di
    set angle to_subtract angle 6d283185_f32
  do
  var orbit_x is to_cos angle
  set orbit_x to_multiply orbit_x 120d0_f32
  set orbit_x to_add orbit_x 576d0_f32
  var orbit_y is to_sin angle
  set orbit_y to_multiply orbit_y 120d0_f32
  set orbit_y to_add orbit_y 324d0_f32

  // The pointer stays 40 px from the centre of the rectangle, on the side that
  // faces the orbiter: to_atan2 finds that direction, and to_cos and to_sin
  // turn it back into a position.
  var center_x is x
  set center_x to_add center_x 16d0_f32
  var center_y is 249d0_f32
  var dx is orbit_x
  set dx to_subtract dx center_x
  var dy is orbit_y
  set dy to_subtract dy center_y
  var heading is to_atan2 dy dx
  var pointer_x is to_cos heading
  set pointer_x to_multiply pointer_x 40d0_f32
  set pointer_x to_add pointer_x center_x
  var pointer_y is to_sin heading
  set pointer_y to_multiply pointer_y 40d0_f32
  set pointer_y to_add pointer_y center_y

  // Drawing a square at a centre needs its top left corner.
  set orbit_x to_subtract orbit_x 8d0_f32
  set orbit_y to_subtract orbit_y 8d0_f32
  set pointer_x to_subtract pointer_x 4d0_f32
  set pointer_y to_subtract pointer_y 4d0_f32

  gfx_clear color_background
  draw_rectangle x 240d0_f32 32d0_f32 18d0_f32 color_rectangle
  draw_rectangle orbit_x orbit_y 16d0_f32 16d0_f32 color_rectangle
  draw_rectangle pointer_x pointer_y 8d0_f32 8d0_f32 color_rectangle
do

gfx_main
di
  sleep_ms 12600_u32
  return exit_success
do
