// info.bosonoga

main
di
  var whole is -7_i32
  var real is 2d5_f32
  var flags is shift_0 shift_or shift_2
  info "whole=" whole
  info "real=" real " flags=" flags
  info 1_i32 "ada" 23_i32 "dido" 456_i32
  info 2_i32 "dada" 345_i32 "dida" 6789_i32

  set whole to_add whole 10_i32
  info whole
  to_3 with i
  di
    info i " " whole
  do

  var converted is to_f32 whole
  set real to_add real 0d25_f32
  info converted " " real " " 1d5_f32 " " 12d003_f32 " " -0d75_f32
  info shift_31 " " -2147483648_i32
  info "čć agápē ćč"
  return exit_success
do
