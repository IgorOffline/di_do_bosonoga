// power.bosonoga

main
di
  var four is 4d0_f32
  var root is to_sqrt four
  info root
  var two is 2d0_f32
  set two to_sqrt two
  info two
  var zero is to_sqrt 0d0_f32
  info zero

  var cube is to_pow 2d0_f32 3d0_f32
  info cube
  var inverse is to_pow 2d0_f32 -1d0_f32
  info inverse
  var odd is to_pow -2d0_f32 3d0_f32
  info odd
  var one is to_pow 0d0_f32 0d0_f32
  info one
  var half is 0d5_f32
  set half to_pow 9d0_f32 half
  info half

  return exit_success
do
