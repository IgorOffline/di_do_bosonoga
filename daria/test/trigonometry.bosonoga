// trigonometry.bosonoga

main
di
  var zero is 0d0_f32
  var sine is to_sin zero
  var cosine is to_cos zero
  info sine " " cosine

  var right_angle is 1d5707963_f32
  set sine to_sin right_angle
  var half_turn is 3d14159265_f32
  set cosine to_cos half_turn
  info sine " " cosine

  var angle is 0d5_f32
  set angle to_sin angle
  info angle

  var heading is to_atan2 1d0_f32 1d0_f32
  info heading
  set heading to_atan2 0d0_f32 -1d0_f32
  info heading
  set heading to_atan2 -1d0_f32 0d0_f32
  info heading
  set heading to_atan2 0d0_f32 0d0_f32
  info heading

  return exit_success
do
