// accumulate.bosonoga

bosonoga_main
di
  var negated is 0_i32
  set negated to_subtract 7_i32
  var half is 0d0_f64
  set half to_divide 2d0_f64
  var remainder is 0_u32
  set remainder to_mod 17_u32 5_u32
  var product is 1_i64
  set product to_multiply 3000000000_i64 3_i64
  var largest is 0_u64
  set largest to_add 18446744073709551614_u64 1_u64
  // 2147483648 is past i32 on the way, as the accumulator is wider.
  var past is 0_i32
  set past to_add 2147483647_i32 1_i32 -2_i32
  var real_mod is 0d0_f32
  set real_mod to_mod 7d5_f32 2d0_f32
  var same is 0_i32
  set same to 42_i32

  if negated eq -7_i32
  and half eq_6 0d5_f64
  and remainder eq 2_u32
  and product eq 9000000000_i64
  and largest eq 18446744073709551615_u64
  and past eq 2147483646_i32
  and real_mod eq_6 1d5_f32
  and same eq 42_i32
  di
    return exit_success
  do
  return exit_failure
do
