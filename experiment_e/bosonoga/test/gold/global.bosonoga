// global.bosonoga

// What bosonoga_global declares at its top is kept for bosonoga_main.
bosonoga_global
di
  var total is 0_i64
  val step is to_i64 global_lap_count
  to_4 with index
  di
    var widened is to_i64 index
    set total to_add total widened step
  do
  val label is new str of "total "_str total
  info label
  unset label
do

// A function sees none of them, so its parameter can have the name of one.
def twice_fn total_i64 ret 0_i64
di
  var doubled is total_i64
  set doubled to_multiply doubled 2_i64
  return doubled
do

bosonoga_main
di
  set total to twice_fn of total with ret 0_i64
  info "twice "_str total
  if total eq 36_i64
  di
    return exit_success
  do
  return exit_failure
do
