// recursion.bosonoga

def factorial_fn number_u64 ret 0_u64
di
  if number_u64 le 1_u64
  di
    return 1_u64
  do
  var smaller is number_u64
  set smaller to_subtract number_u64 1_u64
  var rest is factorial_fn of smaller with ret 0_u64
  var product is 0_u64
  set product to_multiply number_u64 rest
  return product
do

def countdown_fn left_i32 ret_void
di
  if left_i32 eq 0_i32
  di
    return
  do
  var next is 0_i32
  set next to_subtract left_i32 1_i32
  call countdown_fn of next
do

bosonoga_main
di
  var twenty is factorial_fn of 20_u64 with ret 0_u64
  call countdown_fn of 1000_i32
  if twenty eq 2432902008176640000_u64
  di
    return exit_success
  do
  return exit_failure
do
