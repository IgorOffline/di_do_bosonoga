// results.bosonoga

def divide_fn dividend_i32 divisor_i32 ret 0_i32 1_i32
di
  var quotient is 0_i32
  set quotient to_divide dividend_i32 divisor_i32
  var remainder is 0_i32
  set remainder to_mod dividend_i32 divisor_i32
  return quotient remainder
do

def label_fn ret 0_str 1_bool
di
  return "seventeen"_str true_bool
do

bosonoga_main
di
  call divide_fn of 17_i32 5_i32 with ret
    0_i32 as quotient
    1_i32 as remainder
  di
    call label_fn with ret 0_str as label 1_bool as known
    di
      info label " is "_str quotient " times 5 and "_str remainder
      // Only the values that a block needs are taken.
      call divide_fn of 9_i32 2_i32 with ret 1_i32 as odd
      di
        if quotient eq 3_i32
        and remainder eq 2_i32
        and odd eq 1_i32
        and known
        di
          return exit_success
        do
      do
    do
  do
  return exit_failure
do
