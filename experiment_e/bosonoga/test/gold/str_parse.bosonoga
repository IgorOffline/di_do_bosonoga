// str_parse.bosonoga

val texts is array 0_str
di
  row "12"_str
  row "-42"_str
  row "007"_str
  row "18446744073709551615"_str
  row "x1"_str
do

// The number of a text, or -1_i64 when it is none that fits an i64.
def parsed_fn text_str ret 0_i64
di
  str_parse text_str with ret 0_bool as is_number 1_i64 as number
  di
    if is_number
    di
      return number
    do
  do
  return -1_i64
do

bosonoga_main
di
  var sum is 0_i64
  to_5 with index
  di
    call texts at index with ret 0_str as text
    di
      var number is parsed_fn of text with ret 0_i64
      info text " "_str number
      set sum to_add sum number
    do
  do
  str_parse "18446744073709551615"_str with ret 0_bool as is_u64 1_u64 as big
  di
    info is_u64 " "_str big
  do
  str_parse "4294967296"_str with ret 0_bool as is_u32 1_u32 as small
  di
    info is_u32 " "_str small
  do
  if sum eq -33_i64
  di
    return exit_success
  do
  return exit_failure
do
