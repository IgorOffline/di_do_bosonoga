// with_len_col_zeroed.bosonoga

bosonoga_main
di
  var cells is array 0_i32 1_u64 2_f64 3_bool 4_str 5_color with_len_col 2_i32
  call cells at 1_i32 with ret
    0_i32 as count
    1_u64 as total
    2_f64 as weight
    3_bool as done
    4_str as label
    5_color as tint
  di
    info count " "_str total " "_str done " ["_str label "] "_str tint
    if weight eq_6 0_f64
    di
      return exit_success
    do
  do
  return exit_failure
do
