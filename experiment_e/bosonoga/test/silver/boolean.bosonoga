// boolean.bosonoga

const enabled is true_bool

bosonoga_main
di
  val disabled is false_bool
  var seen is false_bool
  if enabled
  and not disabled
  and enabled not_eq disabled
  di
    set seen to true_bool
  do
  if seen eq true_bool
  or disabled
  di
    return exit_success
  do
  return exit_failure
do
