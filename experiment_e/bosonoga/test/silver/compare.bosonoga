// compare.bosonoga

bosonoga_main
di
  val small is 10_i32
  val also_small is 10_i32
  val large is 30_i32
  val wide is -5000000000_i64
  val unsigned is 4000000000_u32
  val huge is 18446744073709551615_u64
  val third is 0d333_f32
  val pi is 3d14159265358979_f64

  if small lt large
  and large gt small
  and small le also_small
  and small ge also_small
  and small eq also_small
  and small not_eq large
  and not small gt large
  and wide lt -4999999999_i64
  and unsigned gt 3999999999_u32
  and huge eq 18446744073709551615_u64
  and third eq_3 0d3333_f32
  and third not_eq_6 0d3333_f32
  and pi eq_6 3d141592_f64
  and pi not_eq_6 3d1415_f64
  di
    if large lt small
    or small eq large
    or pi gt 3d0_f64
    and pi lt 4d0_f64
    di
      return exit_success
    do
  do
  return exit_failure
do
