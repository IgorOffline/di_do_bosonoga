// join.bosonoga

bosonoga_main
di
  var count is 3_i32
  val line is new str of "count "_str count " is "_str true_bool
  info line
  var matched is false_bool
  if line eq "count 3 is true"_str
  di
    set matched to true_bool
  do
  unset line

  // Once unset, a name can be declared again.
  var line is new str of 1d5_f32 "-"_str 18446744073709551615_u64
  info line
  var other is new str of line "!"_str
  info other
  unset other
  unset line

  if matched
  di
    return exit_success
  do
  return exit_failure
do
