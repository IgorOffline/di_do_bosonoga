// loop.bosonoga

bosonoga_main
di
  // 0 + 1 + 2 + 3 + 4
  var total is 0_i32
  to_5 with index
  di
    set total to_add total index
  do

  var countdown is 3_i32
  var steps is 0_i32
  while countdown gt 0_i32
  di
    set countdown to_subtract countdown 1_i32
    set steps to_add steps 1_i32
    sleep_ms 1_u32
  do

  // 1, 3 and 5, as 7 breaks the loop
  var odd is 0_i32
  to_10 with number
  di
    if number eq 7_i32
    di
      break
    do
    var remainder is 0_i32
    set remainder to_mod number 2_i32
    if remainder eq 0_i32
    di
      continue
    do
    set odd to_add odd 1_i32
  do

  var never is 0_i32
  to_0
  di
    set never to 1_i32
  do

  // Setting the variable of a loop does not change its iterations.
  var turns is 0_i32
  to_3 with turn
  di
    set turn to_add turn 100_i32
    set turns to_add turns 1_i32
  do

  if total eq 10_i32
  and steps eq 3_i32
  and countdown eq 0_i32
  and odd eq 3_i32
  and never eq 0_i32
  and turns eq 3_i32
  di
    return exit_success
  do
  return exit_failure
do
