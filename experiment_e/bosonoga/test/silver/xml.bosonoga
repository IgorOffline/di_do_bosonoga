// xml.bosonoga

const catalog is "<catalog><book id='b1' title='Na Drini &amp; ćuprija'/><book id='b2'>Prokleta avlija</book></catalog>"_xml_str

bosonoga_main
di
  var count is 2_i32
  // The values of an element are escaped, and its content can be an xml_str.
  val shelf is new xml_str element "shelf"_str "count"_str count "note"_str "<a & b>"_str of "<wall/>"_xml_str
  info shelf
  var notes is new xml_str of "a < b"_str
  set notes to_join "<br/>"_xml_str count
  info notes

  // The second child named book, which the block is given and frees after it.
  xml_child catalog "book"_str 1_i32 with ret 0_bool as found 1_xml_str as book
  di
    if found
    di
      info book
    do
  do
  var title_found is false_bool
  xml_child catalog "book"_str 0_i32 with ret 1_xml_str as first
  di
    xml_attribute first "title"_str with ret 0_bool as has_title 1_str as title
    di
      if has_title and title eq "Na Drini & ćuprija"_str
      di
        set title_found to true_bool
      do
      info title
    do
  do
  xml_child catalog "book"_str 2_i32 with ret 0_bool as third
  di
    if third
    di
      set title_found to false_bool
    do
  do
  xml_attribute shelf "count"_str with ret 1_str as shelf_count
  di
    info shelf_count
  do

  // A str and an xml_str are compared by their text.
  val empty is new xml_str element "empty"_str
  var is_empty is false_bool
  if empty eq "<empty/>"_str
  di
    set is_empty to true_bool
  do
  unset empty
  unset notes
  unset shelf
  if title_found and is_empty
  di
    return exit_success
  do
  return exit_failure
do
