var running_total is 100_i32
to_8
di
  set running_total to_add running_total 1_i32
do
to_3 with i
di
  set running_total to_add running_total i
do
to_3 with i
di
  nihil
do
to_3 with i
di
  to_2 with j
  di
    set running_total to_add running_total i j
  do
do
if running_total eq 120_i32
di
  return exit_success
do
return exit_failure
